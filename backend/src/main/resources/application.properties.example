# Application Configuration
# =========================
# This file is an example. COPY it to 'application.properties' and fill in the values.
# DO NOT commit the real 'application.properties' to version control if it contains secrets.

# Server Configuration
server.port=8080
spring.application.name=gestao-financeira-backend

# CORS Configuration
# Adjust allowed origins as needed (e.g., for frontend development)
spring.web.cors.allowed-origins=http://localhost:5173
spring.web.cors.allowed-methods=GET,POST,PUT,DELETE,OPTIONS
spring.web.cors.allowed-headers=*
spring.web.cors.allow-credentials=true

# Frontend URL
app.frontend.url=http://localhost:5173

# Cross-Domain Cookie Configuration
server.forward-headers-strategy=framework
server.servlet.session.cookie.secure=true
server.servlet.session.cookie.same-site=none

# Google Sheets Configuration
# ---------------------------
# The spreadsheet ID is now managed automatically per user.
# The application will find or create a spreadsheet named "Gestão Financeira Pessoal - [User Name]".
# You do not need to configure an ID here.
# google.sheets.spreadsheet.id=

# Google OAuth2 Client Configuration
# ----------------------------------
# You must obtain these credentials from the Google Cloud Console:
# https://console.cloud.google.com/
#
# Steps:
# 1. Create a Project.
# 2. Enable "Google Sheets API" and "Google Drive API".
# 3. Configure the "OAuth Consent Screen" (External, Add Test Users).
# 4. Create Credentials -> OAuth Client ID -> Web Application.
# 5. Add Authorized Redirect URI: http://localhost:8080/login/oauth2/code/google
#
# Replace the placeholders below with your actual Client ID and Client Secret.

spring.security.oauth2.client.registration.google.client-id=YOUR_CLIENT_ID_HERE
spring.security.oauth2.client.registration.google.client-secret=YOUR_CLIENT_SECRET_HERE

# Scopes required for the application
spring.security.oauth2.client.registration.google.scope=openid,profile,email,https://www.googleapis.com/auth/spreadsheets,https://www.googleapis.com/auth/drive.file

# Standard OAuth2 configuration (usually doesn't need changing)
spring.security.oauth2.client.registration.google.redirect-uri={baseUrl}/login/oauth2/code/{registrationId}
spring.security.oauth2.client.registration.google.authorization-grant-type=authorization_code

spring.security.oauth2.client.provider.google.authorization-uri=https://accounts.google.com/o/oauth2/v2/auth
spring.security.oauth2.client.provider.google.token-uri=https://oauth2.googleapis.com/token
spring.security.oauth2.client.provider.google.user-info-uri=https://openidconnect.googleapis.com/v1/userinfo
spring.security.oauth2.client.provider.google.user-name-attribute=sub

# Logging
logging.level.root=INFO
logging.level.com.financeiro=DEBUG
logging.level.org.springframework.security=INFO
